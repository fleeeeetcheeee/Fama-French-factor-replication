# SEC requires a descriptive User-Agent on every request and bans the IP without one.
# Must be a real name and address — config.require_real_user_agent() rejects placeholders.
SEC_USER_AGENT="Your Name your@email.com"

# Where this project writes its own raw/processed data. Defaults to ./data
# DATA_ROOT=/path/to/data

# Root of Project 01's processed store, if using it as the fundamentals/price source.
# Consumed as data — this project does not import the tierzero package.
# PIT_STORE_ROOT=/Users/you/Documents/Portfolio/TierZero/Project01-PointInTimeEquityDataPipeline/data/processed
