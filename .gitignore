# Environment
.env
.env.local

# Data (too large for git)
data/raw/
data/processed/

# Backtest output
results/

# data/results/ is regenerated by the scripts in scripts/. Only the derived
# factor return series are versioned; tables built from licensed CRSP and
# Compustat records (portfolio firm counts, per-year diagnostics) stay local.
!data/results/
data/results/*
!data/results/bottom_up/
data/results/bottom_up/*
!data/results/bottom_up/factors.csv
!data/results/qfactors/
data/results/qfactors/*
!data/results/qfactors/q_factors.csv

# Plugin session state
.omc/

